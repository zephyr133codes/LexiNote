# Gradle / Android Studio caches
.gradle/
.kotlin/
.idea/
*.iml

# Build outputs
**/build/
*.apk
*.aab

# Local environment settings
local.properties
**/local.properties

# Generated native build files
.cxx/
.externalNativeBuild/
captures/

# Operating system files
.DS_Store
Thumbs.db

# ECDICT source data and generated output
tools/dictionary/raw/
tools/dictionary/output/*.db
tools/dictionary/output/*.db-*
tools/dictionary/reports/build_report.json

# Keep the bundled Android dictionary
!android/app/src/main/assets/dictionary.db

# Python caches
__pycache__/
*.pyc
/android/app/release/
